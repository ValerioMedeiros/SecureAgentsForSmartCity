# Smart City Traffic Management - Configuration Example
# Copy this file to .env and fill in with your actual values

# ============================================
# OpenAI / LLM Configuration
# ============================================

# Set to "true" to automatically execute plans generated by the LLM planner
EXECUTE_PLANS=true

# Enable LLM-based planning (set to "true" to enable)
LLM_PLANNER_ENABLED=true

# OpenAI API key (required if LLM_PLANNER_ENABLED=true)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for planning
OPENAI_MODEL=gpt-4o-mini

# LLM temperature for plan generation

LLM_TEMPERATURE=0.3

# ============================================
# OPA (Open Policy Agent) Configuration
# ============================================

# Set to enable OPA-based policy evaluation
# Leave empty to use fallback policy engine
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=v1/data/smartcity/allow
OPA_TIMEOUT_SECONDS=1.5

# ============================================
# FIWARE MCP Server
# ============================================

# URL of the FIWARE Orion MCP Server (github.com/seu-usuario/Fiware_MCP)
# Start it with: fastmcp run fiware_mcp_server.py --transport http --port 8001
FIWARE_MCP_URL=http://localhost:8001/mcp

# ============================================
# Keycloak (IAM — Identity and Access Management)
# ============================================

# Authenticates operators and provides scoped credentials. When enabled, the
# Citizen-Facing Interface requires an authenticated operator holding a role
# that permits the requested pump actuation before an approval can be granted.
# Set to "false" to run the PoC in open mode (no authentication).
KEYCLOAK_ENABLED=true
# Internal base URL (no trailing slash, no /realms). Inside docker-compose this
# is http://keycloak:8080; from the host it is http://localhost:8090.
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=smartcity
KEYCLOAK_CLIENT_ID=smartcity-poc
KEYCLOAK_CLIENT_SECRET=smartcity-poc-secret
# Optional: comma-separated audiences to enforce on the `aud` claim. Leave
# empty to skip audience checks (signature, issuer and expiry are always
# verified). Requires a Keycloak audience mapper if set.
KEYCLOAK_AUDIENCE=

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO

# Structured JSON log file (per-stage events, trace-correlated)
JSON_LOG_FILE=logs/traces.jsonl

# ============================================
# Observability & Audit
# ============================================

# Tamper-evident audit log (hash-chained JSONL) of policy decisions and
# tool invocations. Queryable through monitor service endpoints:
#   GET  /audit/entries?trace_id=...&plan_id=...&component=...&event_type=...
#   GET  /audit/entries/{id}
#   GET  /audit/verify
# Prometheus metrics are exposed at /metrics on both monitor and MCP server.
AUDIT_LOG_FILE=logs/audit.jsonl